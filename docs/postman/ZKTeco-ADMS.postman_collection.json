{
  "info": {
    "_postman_id": "241894ea-2f85-4327-88be-700518f1c11e",
    "name": "ZKTeco ADMS",
    "description": "Simulates a ZKTeco device in ADMS (push) mode talking to this app.\n\nSet `base_url` in the environment (for example `http://localhost:8000` with `php artisan serve`, or `http://192.168.200.209:7788`). Run the whole collection with the Collection Runner.\n\nPunch requests send REAL Telegram messages when TELEGRAM_BOT_TOKEN and TELEGRAM_ERROR_CHAT_ID are set. Every request also appears in storage/logs/requests-YYYY-MM-DD.log.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// {{now}}: current time in the device's format, YYYY-MM-DD HH:mm:ss",
          "const d = new Date(), p = n => String(n).padStart(2, '0');",
          "pm.variables.set('now', `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`);",
          "",
          "// {{backlog}}: 200 punch lines for the large-batch request",
          "const now = pm.variables.get('now');",
          "pm.variables.set('backlog', Array.from({length: 200}, (_, i) => `${9000 + i}\\t${now}\\t${i % 2}\\t15\\t0`).join('\\n'));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "device_sn",
      "value": "POSTMAN-TEST-01"
    }
  ],
  "item": [
    {
      "name": "1. Device connection",
      "item": [
        {
          "name": "1. Handshake (device boots)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Plain text reply', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));",
                  "const body = pm.response.text();",
                  "pm.test('Echoes the serial number', () => pm.expect(body).to.include('GET OPTION FROM: ' + pm.variables.get('device_sn')));",
                  "pm.test('Asks for missing punches', () => pm.expect(body).to.include('ATTLOGStamp=None'));",
                  "pm.test('Real-time push on', () => pm.expect(body).to.include('Realtime=1'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/iclock/cdata?SN={{device_sn}}&options=all&pushver=2.4.1&language=69",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iclock",
                "cdata"
              ],
              "query": [
                {
                  "key": "SN",
                  "value": "{{device_sn}}"
                },
                {
                  "key": "options",
                  "value": "all"
                },
                {
                  "key": "pushver",
                  "value": "2.4.1"
                },
                {
                  "key": "language",
                  "value": "69"
                }
              ]
            },
            "description": "The first call a device makes. The reply holds its upload settings (ATTLOGStamp, Realtime, Delay, ...)."
          }
        },
        {
          "name": "2. Poll for commands (getrequest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Plain text reply', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));",
                  "pm.test('Reply is OK', () => pm.expect(pm.response.text().trim()).to.eql('OK'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/iclock/getrequest?SN={{device_sn}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iclock",
                "getrequest"
              ],
              "query": [
                {
                  "key": "SN",
                  "value": "{{device_sn}}"
                }
              ]
            },
            "description": "The device polls this every Delay seconds. No commands are queued, so the reply is OK."
          }
        },
        {
          "name": "3. Command result (devicecmd)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Plain text reply', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));",
                  "pm.test('Reply is OK', () => pm.expect(pm.response.text().trim()).to.eql('OK'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{base_url}}/iclock/devicecmd?SN={{device_sn}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "iclock",
                "devicecmd"
              ],
              "query": [
                {
                  "key": "SN",
                  "value": "{{device_sn}}"
                }
              ]
            },
            "description": "The device reports the result of a command here.",
            "body": {
              "mode": "raw",
              "raw": "ID=1&Return=0&CMD=DATA",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          }
        }
      ]
    },
